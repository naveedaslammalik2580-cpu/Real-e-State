node_modules/
# package-lock.json is committed on purpose: CI installs with `npm ci`
# (cache-dependency-path: tests/package-lock.json in .github/workflows/tests.yml),
# which cannot run without a tracked lockfile.

# The migrated-database snapshot the SQL tests build for themselves
# (tests/helpers/pg.mjs). Keyed by every migration name + content, so it
# rebuilds itself whenever a migration changes. Never committed.
.cache/
